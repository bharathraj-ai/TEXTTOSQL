PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/nl_sql_db
APP_DATABASE_URL=postgresql://username:password@localhost:5432/nl_sql_db
JWT_SECRET=your_super_secret_jwt_key_here
ENCRYPTION_KEY=64_character_hex_string_32_bytes_aes_gcm_key
# Day 5 OpenRouter Safety & Semantic Reviewer
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_ENABLED=true
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_MAX_BUDGET_USD=0.80
OPENROUTER_MAX_OUTPUT_TOKENS=200
OPENROUTER_MAX_REQUESTS_PER_DAY=20
OPENROUTER_TIMEOUT_MS=15000
ALLOW_SELECT_ON_REVIEW_FAILURE=true
# Conversational replies (greetings and help). Not used for SQL.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
